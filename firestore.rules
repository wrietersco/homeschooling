rules_version = '2';

// Tenancy + role model (Phase 1).
//
// Roles on families/{id}/members/{uid}.data.role: 'owner' | 'parent' | 'viewer'.
//   - owner  : full control incl. managing members + family settings
//   - parent : read + write family content (profiles, children, activities…)
//   - viewer : read-only
//
// IMPORTANT: Firestore evaluates every matching rule and allows if ANY grants
// access (OR semantics). A broad `/{document=**}` write rule would therefore
// override a stricter rule on a nested path. To keep "only the owner mutates
// members" we DO NOT use a tenant-wide catch-all; each collection group gets a
// distinct, non-overlapping match.
//
// Invariants:
//   * A user can only touch a family they are a member of (or superadmin).
//   * Family + member docs are created server-side (createFamily callable using
//     the Admin SDK), never directly by clients.
//   * Platform config is superadmin-only; the global skill registry is readable
//     by any signed-in user.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && accountActive();
    }
    function accountActive() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(path) ||
        ((!('disabled' in get(path).data) || get(path).data.disabled != true) &&
        (!('sessionValidAfterSeconds' in get(path).data) ||
          request.auth.token.auth_time >= get(path).data.sessionValidAfterSeconds));
    }
    function familyActive(familyId) {
      let path = /databases/$(database)/documents/families/$(familyId);
      return exists(path) && (!('status' in get(path).data) || get(path).data.status != 'disabled');
    }
    function subscribed(familyId) {
      let path = /databases/$(database)/documents/families/$(familyId)/billing/subscription;
      return exists(path) && get(path).data.status == 'active' &&
        get(path).data.startsAt <= request.time && get(path).data.endsAt > request.time;
    }
    function isSuperAdmin() {
      return signedIn() && ('platformRole' in request.auth.token) && request.auth.token.platformRole == 'superadmin';
    }
    function memberPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid);
    }
    function isMember(familyId) {
      return signedIn() && exists(memberPath(familyId));
    }
    function memberRole(familyId) {
      return get(memberPath(familyId)).data.role;
    }
    function canManage(familyId) {
      return isMember(familyId) && memberRole(familyId) == 'owner';
    }
    function canWrite(familyId) {
      return isMember(familyId) && familyActive(familyId) && subscribed(familyId) && memberRole(familyId) in ['owner', 'parent'];
    }
    function canRead(familyId) {
      return (isMember(familyId) && familyActive(familyId) && subscribed(familyId)) || isSuperAdmin();
    }
    function writable(familyId) {
      return canWrite(familyId) || isSuperAdmin();
    }

    // Account access fields and family pointers are server-controlled. Users
    // may edit only their display name, and can read suspension state to sign out.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow create, delete: if false;
    }

    // Platform config (incl. platform/pricing): superadmin only.
    match /platform/{doc=**} {
      allow read, write: if isSuperAdmin();
    }

    // Platform-wide cost rollups: superadmin read; written server-side (Admin SDK).
    match /platformCostRollups/{period} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /platformAudit/{eventId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Global skill registry (top-level collection): readable by any signed-in
    // user so families can pick from it. Writes are server-side only — when a
    // family manager adds a skill it is mirrored here by a Cloud Function
    // (Admin SDK), so clients never write arbitrary global data directly.
    match /skillRegistry/{skillId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // Shared Quran corpus (top-level): readable by any signed-in user; imported
    // and maintained only by the superadmin via the importQuran callable.
    match /quran/{doc=**} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // Shared Noorani Qaida corpus (top-level): PUBLICLY readable. The unauthenticated
    // child player resolves each drill glyph's current recording live from here (by
    // materialRef) so activities pick up audio as it's generated over time. The
    // content is standard, non-sensitive Qaida letters + already-public Storage audio
    // URLs, and replaying cached audio costs nothing — so open read is acceptable.
    // Imported, audio-generated, and audited only by the superadmin.
    match /nooraniQaida/{doc=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /families/{familyId} {
      // Family creation/deletion is server-side only (callables w/ Admin SDK).
      allow read: if isMember(familyId) || isSuperAdmin();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (canManage(familyId) && familyActive(familyId) && subscribed(familyId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']));

      // Members: readable by any member; only the owner (or superadmin) mutates.
      match /members/{memberUid} {
        allow read: if canRead(familyId);
        allow write: if canManage(familyId) || isSuperAdmin();
      }

      // Observations are bound to their author: a parent writes only their own
      // and cannot rewrite another parent's observation.
      match /observations/{obsId} {
        allow read: if canRead(familyId);
        allow create: if writable(familyId) &&
          request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isSuperAdmin() ||
          (writable(familyId) && resource.data.authorUid == request.auth.uid);
      }

      // Server-maintained: the agent DB index and agent run records are written
      // by Cloud Functions (Admin SDK). Clients read; only superadmin writes.
      match /_agent_index/{path=**} {
        allow read: if canRead(familyId);
        allow write: if isSuperAdmin();
      }
      match /agentRuns/{path=**} {
        allow read: if canRead(familyId);
        allow write: if isSuperAdmin();
      }

      // Cost metering (Phase A) — deep per-call log + rollups. Superadmin-only:
      // families do not see dollar figures. Written server-side (Admin SDK).
      match /costEvents/{path=**} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }
      match /costRollups/{path=**} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }
      match /billing/{path=**} { allow read, write: if isSuperAdmin(); }
      match /planUsage/{period} { allow read: if canRead(familyId); allow write: if false; }

      // Member-read / parent-write content (each match also covers the group's
      // nested subcollections via {path=**}).
      match /profile/{path=**}      { allow read: if canRead(familyId); allow write: if writable(familyId); }
      match /meta/{path=**}         { allow read: if canRead(familyId); allow write: if writable(familyId); }
      match /guardians/{path=**}    { allow read: if canRead(familyId); allow write: if writable(familyId); }
      match /children/{path=**}     { allow read: if canRead(familyId); allow write: if writable(familyId); }
      match /skills/{path=**}       { allow read: if canRead(familyId); allow write: if writable(familyId); }
      match /curriculum/{path=**}   { allow read: if canRead(familyId); allow write: if writable(familyId); }
      match /activities/{path=**}   { allow read: if canRead(familyId); allow write: if writable(familyId); }
      // Per-subject content plans (the "canvas"): written server-side by the
      // planning agent (Admin SDK); members read to review the arc before/after
      // generating content.
      match /subjectPlans/{path=**} { allow read: if canRead(familyId); allow write: if isSuperAdmin(); }
      match /calendarDays/{path=**}        { allow read: if canRead(familyId); allow write: if writable(familyId); }
      match /scheduleTemplates/{path=**}  { allow read: if canRead(familyId); allow write: if writable(familyId); }
      // Player tokens are publicly readable — the token ID is an unguessable UUID
      // that functions as a capability credential for the child's unauthenticated
      // device. Expiry is enforced server-side here (audit #6): a token with an
      // expiresAtMs in the past is no longer readable. Tokens written before this
      // field existed (no expiresAtMs) remain readable for backward compatibility.
      match /playerTokens/{tokenId} {
        allow read: if familyActive(familyId) && subscribed(familyId) &&
          (!('expiresAtMs' in resource.data) || resource.data.expiresAtMs > request.time.toMillis());
        allow write: if writable(familyId);
      }
      match /scores/{path=**}       { allow read: if canRead(familyId); allow write: if writable(familyId); }
      match /exposures/{path=**}    { allow read: if canRead(familyId); allow write: if writable(familyId); }
      match /contentStats/{path=**} { allow read: if canRead(familyId); allow write: if writable(familyId); }
      match /intercom/{path=**}     { allow read: if canRead(familyId); allow write: if writable(familyId); }
      // Explore live-conversation log: written only by Cloud Functions (Admin SDK);
      // family members can read it.
      match /exploreSessions/{path=**} { allow read: if canRead(familyId); allow write: if false; }
      // Invites: any signed-in user can read by knowing the UUID path (token = capability).
      // Only the owner creates invites; status updates happen via Cloud Function (Admin SDK).
      match /invites/{inviteId} {
        allow read: if signedIn();
        allow create: if canManage(familyId) || isSuperAdmin();
        allow update, delete: if isSuperAdmin();
      }
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
